# Copia este archivo a ".env" (mismo nivel, junto a docker-compose.yml) y
# completa los valores. ".env" nunca se sube al repo (ver .gitignore).
#
#   cp .env.example .env
#
# Con el .env completo, "docker compose up --build" levanta todo: base de
# datos, backend y frontend, sin tocar ni un archivo de configuracion mas.
#
# ESTE ARCHIVO ES LA LISTA OFICIAL DE VARIABLES: los mismos nombres valen para
# los dos modos de ejecucion:
#   - Docker/produccion: se copian a ".env" y compose las inyecta.
#   - Terminales (mvn spring-boot:run): se exportan como variables del SO
#     (ej. $env:DB_PASSWORD="..." en PowerShell) o se escriben en el archivo
#     NO versionado nuevo-horizonte-Backend/config/application.properties
#     con formato properties, ej:
#       spring.datasource.password=...
#       app.jwt.secret=...
#     (Spring lo carga solo y pisa los defaults neutros). Ese archivo jamas
#     se sube al repo: solo este .example documenta que variables existen.

# --- Base de datos ---
DB_NAME=nuevo_horizonte
DB_USERNAME=postgres
DB_PASSWORD=cambia-esta-clave
# Puerto del host para la BD (solo desarrollo/depuracion; el backend usa el 5432 interno).
DB_PORT=5432

# --- Seguridad ---
# Genera una clave larga y aleatoria propia, no reuses el valor de ejemplo.
# Ej: openssl rand -base64 48
JWT_SECRET=cambia-esta-clave-por-una-generada-al-azar
# true si el sitio se sirve por HTTPS (produccion real). false para probar
# en local por HTTP plano (docker-compose en localhost sin certificado) -el
# navegador no manda cookies "Secure" por HTTP, asi que con true el login
# quedaria roto en ese caso.
COOKIE_SECURE=false

# --- URL publica del frontend ---
# La que vera el navegador. Se usa para CORS y para armar el enlace de
# recuperacion de contraseña que se manda por correo.
FRONTEND_URL=http://localhost

# Puerto donde queda expuesto el frontend (nginx) en el host.
APP_PORT=80

# --- Seeds de demostracion ---
# true crea ADM/GRT/AP/AV (admin123) al arrancar. Para produccion: despliega
# una vez con true, entra, cambia esas claves y crea el admin real; luego
# pon false y redespliega. En false no se crea ni se borra nada, pero una BD
# sin usuarios = lockout, asi que no lo pongas en false en el primer arranque.
SEED_DEMO_USUARIOS=true

# --- Correo (recuperacion de contraseña) via Resend (resend.com) ---
# Dejar EMAIL_ENABLED=false mientras no tengas una API key: el enlace de
# recuperacion solo queda en el log del backend, no se envia de verdad.
EMAIL_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
