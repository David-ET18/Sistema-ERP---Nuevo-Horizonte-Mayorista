# cp .env.example .env
DB_NAME=nuevo_horizonte
DB_USERNAME=postgres
DB_PASSWORD=cambia-esta-clave
DB_PORT=5432

# SEGURIDAD
JWT_SECRET=cambia-esta-clave-por-una-generada-al-azar
COOKIE_SECURE=false

# FRONTEND
FRONTEND_URL=http://localhost
APP_PORT=80

# HTTPS (opcional, solo para EC2 con dominio propio - ver init-letsencrypt.sh)
# Vacio = HTTP normal en :80, como hoy. Con DOMAIN apuntando por DNS a la IP
# publica del EC2, corre ./init-letsencrypt.sh una vez y el sitio pasa a
# HTTPS solo, sin tocar nada mas. OJO: cuando definas DOMAIN, actualiza
# tambien FRONTEND_URL arriba (a https://tu-dominio) y COOKIE_SECURE=true.
DOMAIN=
CERTBOT_EMAIL=

# SEEDS DEMO
SEED_DEMO_USUARIOS=true

# VARIABLES RESEND
EMAIL_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
